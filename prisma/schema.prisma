// نماء (Namaa) — Prisma schema
// Design note: a student's "current position" (surah/ayah), cumulative pages,
// online-recitation count, and cumulative points are NOT stored as mutable
// counters. They are always derived from RecitationSession / PointsLog rows
// (latest session = current position, SUM(pagesCalculated) = cumulative pages,
// etc). This avoids an entire class of sync/drift bugs from incrementing
// counters across concurrent teachers, and makes the session log the single
// source of truth — matching how the log screen already works in the
// prototype. See src/lib/recitation/derive.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Accounts ----------

model Admin {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  // supervisor's own gender, used to conjugate UI text addressed to/about them
  // (e.g. مشرف/مشرفة). Optional and asked only once — see genderPrompted.
  gender         Gender?
  genderPrompted Boolean  @default(false)
  createdAt      DateTime @default(now())

  course          Course?
  resources       Resource[]
  resourceReports ResourceReport[]
}

// A course (دورة) is the multi-tenant boundary. Every other model hangs off
// courseId (directly or via a parent that has courseId), and every query in
// the app must be scoped by the current session's courseId.
model Course {
  id                      String                @id @default(cuid())
  name                    String
  code                    String                @unique
  adminId                 String                @unique
  admin                   Admin                 @relation(fields: [adminId], references: [id], onDelete: Cascade)
  addStudentsPermission   AddStudentsPermission @default(ADMIN_ONLY)
  // who may edit a student's name/age/grade/group, and who may archive one.
  // Restoring and permanently deleting are always supervisor-only.
  editStudentsPermission    AddStudentsPermission @default(ADMIN_ONLY)
  archiveStudentsPermission AddStudentsPermission @default(ADMIN_ONLY)
  // who may add prior memorization (حفظ سابق) to an existing student, and
  // delete a prior entry added by mistake (teachers: students they can see)
  addPriorPermission        AddStudentsPermission @default(ADMIN_ONLY)
  // who may download and upload «التسميع بدون إنترنت» (a day's attendance,
  // recitations and points from an Excel sheet; teachers: their groups only)
  offlineSheetPermission    AddStudentsPermission @default(ADMIN_ONLY)
  // Student login (src/lib/auth/student-session.ts). Off by default; while
  // off, student codes are hidden and every student session is refused.
  // studentBoardEnabled separately allows the course board tab for students
  // (independent of the public board code).
  studentLoginEnabled         Boolean               @default(false)
  studentBoardEnabled         Boolean               @default(false)
  // who may issue/regenerate/revoke student codes (teachers: own groups only)
  issueStudentCodesPermission AddStudentsPermission @default(ADMIN_ONLY)
  // «حفظي في البيت» (src/lib/home-log): only works while student login is
  // on. Default consolidation targets for new home segments (a student may
  // have her own, see Student.homeTarget*).
  homeLogEnabled              Boolean               @default(false)
  homeTargetListen            Int                   @default(5)
  homeTargetRepeat            Int                   @default(10)
  homeTargetRecite            Int                   @default(3)
  // lets students mark their own mistakes word by word while practising a
  // home passage (HomeMistake). Off by default; only works while the home
  // log (and so student login) is on. Strictly private to the student.
  homeMistakesEnabled         Boolean               @default(false)
  // «الواجبات» (src/lib/assignments) and «جدول المتابعة» (src/lib/tracker):
  // each only works while student login is on. While off, the tabs are
  // hidden and every page and action refuses.
  assignmentsEnabled          Boolean               @default(false)
  trackerEnabled              Boolean               @default(false)
  visibilityMode          VisibilityMode        @default(ALL_TEACHERS)
  onlineRecitationEnabled Boolean               @default(true)
  // optional progress bars on the student detail screen, each toggled
  // course-wide by the supervisor. Off by default.
  showSurahProgress       Boolean               @default(false)
  showJuzProgress         Boolean               @default(false)
  showQuranProgress       Boolean               @default(false)
  showPlanProgress        Boolean               @default(false)
  // Public read-only leaderboard access (see src/lib/auth/board-session.ts),
  // independent of the teacher course code above. null = no public board.
  // Regenerating/revoking bumps boardCodeVersion, which every board session
  // is checked against, so old sessions die immediately.
  boardCode               String?               @unique
  boardCodeVersion        Int                   @default(0)
  boardCodeCreatedAt      DateTime?
  // Days a completed surah may go without a REVIEW/LINK session before the
  // student is flagged (src/lib/students/review.ts). null = reminders off.
  reviewReminderDays      Int?
  // What makes a week count toward a student's streak (see
  // src/lib/students/streak.ts). null = streaks off (the default).
  streakMode              StreakMode?
  // Islamic calendar (/calendar), staff-only. Off by default; the banner is
  // only shown while the calendar itself is enabled. The core occasions
  // (Ramadan, both Eids, Arafah) are always on; enabledOccasions lists only
  // the optional presets the course turned on (src/lib/calendar/occasions.ts).
  calendarEnabled         Boolean                @default(false)
  calendarBannerEnabled   Boolean                @default(false)
  calendarEditPermission  CalendarEditPermission @default(ADMIN_ONLY)
  enabledOccasions        Occasion[]             @default([])
  // «معلومات إضافية» about each student (src/lib/students/extra-info.ts).
  // Off by default; while off, nothing is shown or accepted anywhere and the
  // stored values are kept. parentStudentInfoEdit separately lets parents
  // fill/edit the fields visible to them from the parent portal.
  studentInfoEnabled      Boolean                @default(false)
  parentStudentInfoEdit   Boolean                @default(false)
  createdAt               DateTime               @default(now())

  teachers            Teacher[]
  groups              Group[]
  students            Student[]
  pointsActivities    PointsActivity[]
  calendarAdjustments CalendarAdjustment[]
  calendarEvents      CalendarEvent[]
  assignments         Assignment[]
  trackerItems        TrackerItem[]
  studentInfoFields   StudentInfoField[]
}

model Teacher {
  id             String   @id @default(cuid())
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name           String
  // normalized (trimmed + lowercased) name used for case-insensitive login matching
  nameKey        String
  // teacher's own gender, used to conjugate UI text addressed to them directly
  // (e.g. سجّلي/سجّل). Optional and asked only once — see genderPrompted.
  gender         Gender?
  genderPrompted Boolean  @default(false)
  // true only for the per-course stand-in row that the supervisor's own
  // entries are attributed to (src/lib/auth/teacher-identity.ts). Found by
  // this flag, never by name, and no login can ever reach it. At most one
  // per course (partial unique index in the migration).
  isSupervisorProxy Boolean @default(false)
  createdAt      DateTime @default(now())

  groupAssignments TeacherGroupAssignment[]
  recitationLogs   RecitationSession[]
  pointsLogs       PointsLog[]
  attendanceLogs   AttendanceLog[]
  mistakesFlagged  RecitationMistake[]      @relation("MistakeFlaggedBy")
  mistakesResolved RecitationMistake[]      @relation("MistakeResolvedBy")
  calendarEvents   CalendarEvent[]
  resources        Resource[]
  resourceReports  ResourceReport[]
  assignments      Assignment[]
  trackerItems     TrackerItem[]

  @@unique([courseId, nameKey])
  @@index([courseId])
}

// ---------- Course structure ----------

model Group {
  id        String      @id @default(cuid())
  courseId  String
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name      String
  // drives Arabic grammatical gender (طالب/طالبة, حاضر/حاضرة, ...) for every
  // student in this group. Defaults to GIRLS so existing groups keep
  // rendering exactly as before this field existed.
  gender    GroupGender @default(GIRLS)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  students           Student[]
  teacherAssignments TeacherGroupAssignment[]
  assignments        Assignment[]
  trackerItems       TrackerItem[]

  @@unique([courseId, name])
  @@index([courseId])
}

model TeacherGroupAssignment {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([teacherId, groupId])
}

model PointsActivity {
  id        String    @id @default(cuid())
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name      String
  value     Int       @default(1)
  type      PointType @default(ADD)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  logs PointsLog[]

  @@index([courseId])
}

// ---------- Students ----------

model Student {
  id           String       @id @default(cuid())
  courseId     String
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupId      String
  group        Group        @relation(fields: [groupId], references: [id])
  name         String
  age          Int
  // school grade (الصف), free text as the supervisor writes it (e.g. الخامس).
  // Optional: students added before this field existed have none.
  grade        String?
  planTemplate PlanTemplate @default(CUSTOM)
  createdAt    DateTime     @default(now())

  // Read-only parent access (see src/lib/auth/parent-session.ts). null =
  // no parent can log in. Regenerating/revoking bumps parentCodeVersion,
  // which every parent session is checked against, so old sessions die
  // immediately rather than at cookie expiry.
  parentCode          String?   @unique
  parentCodeVersion   Int       @default(0)
  parentCodeCreatedAt DateTime?

  // The student's own login code, separate from the parent code (same
  // version mechanism: regenerating/revoking bumps the version and ends
  // every session opened with the old code).
  studentCode          String?   @unique
  studentCodeVersion   Int       @default(0)
  studentCodeCreatedAt DateTime?

  // per-student home-log targets set by staff; null = the course default
  homeTargetListen Int?
  homeTargetRepeat Int?
  homeTargetRecite Int?

  // Archived instead of deleted: null = active. An archived student drops out
  // of every list, count, board and streak, can't be acted on, and her parent
  // code stops working (it's kept, so restoring brings it back). Her history
  // is untouched. keepInReports decides, while archived, whether her history
  // still counts in reports (and she's listed there, marked as archived).
  archivedAt    DateTime?
  keepInReports Boolean   @default(true)

  planItems          PlanItem[]
  recitationSessions RecitationSession[]
  pointsLogs         PointsLog[]
  attendanceLogs     AttendanceLog[]
  mistakes           RecitationMistake[]
  homeSegments       HomeSegment[]
  homeMistakes       HomeMistake[]
  homeTaps           HomeTap[]
  assignmentTargets  AssignmentStudent[]
  assignmentsDone    AssignmentCompletion[]
  trackerTargets     TrackerItemStudent[]
  trackerItemsOwn    TrackerItem[]          @relation("TrackerItemByStudent")
  trackerChecks      TrackerCheck[]
  infoValues         StudentInfoValue[]

  @@index([courseId])
  @@index([groupId])
  @@index([courseId, archivedAt])
}

// ---------- Extra student information («معلومات إضافية») ----------
//
// Never loaded by the student portal, the board or reports. Who sees and
// edits which field is decided in src/lib/students/extra-info.ts.

// One configurable field of a course: a built-in one (builtinKey set, label
// from code so it can follow the group's gender) or the supervisor's own
// (builtinKey null, label set). Built-in rows are created on demand, all
// disabled. Disabling hides a field but keeps its values; deleting a custom
// field deletes its values (Cascade).
model StudentInfoField {
  id                String              @id @default(cuid())
  courseId          String
  course            Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  builtinKey        StudentInfoBuiltin?
  label             String?
  enabled           Boolean             @default(false)
  required          Boolean             @default(false)
  visibleToTeachers Boolean             @default(true)
  visibleToParents  Boolean             @default(true)
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())

  values StudentInfoValue[]

  // Postgres treats NULLs as distinct, so any number of custom rows fit
  @@unique([courseId, builtinKey])
  @@index([courseId, sortOrder])
}

// A student's value for one field. Never empty: clearing a value deletes the
// row, so "missing" always means "no row".
model StudentInfoValue {
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fieldId   String
  field     StudentInfoField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value     String
  updatedAt DateTime         @updatedAt
  updatedBy InfoEditor

  @@id([studentId, fieldId])
  @@index([fieldId])
}

// A student's memorization plan: an ordered list of surahs, built from a
// template (reverse Mushaf order / Mushaf order / reverse Juz Amma / fully custom) and then freely
// reordered/edited. Gap detection walks this list by `position`, not by raw
// surah number — see spec adaptation note in the technical plan.
model PlanItem {
  id          String  @id @default(cuid())
  studentId   String
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  surahNumber Int
  position    Int

  @@unique([studentId, position])
  @@unique([studentId, surahNumber])
  @@index([studentId])
}

model RecitationSession {
  id              String               @id @default(cuid())
  studentId       String
  student         Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId       String
  teacher         Teacher              @relation(fields: [teacherId], references: [id])
  source          RecitationSource     @default(LOGGED)
  // Only NEW sessions (and PRIOR baselines, which are always NEW) advance
  // the student's position / coverage and go through gap detection.
  // REVIEW/LINK revisit covered material: logged and counted as practice
  // volume, but never move her forward. They feed the review reminders.
  type            SessionType          @default(NEW)
  surahNumber     Int
  fromAyah        Int
  toAyah          Int
  pagesCalculated Decimal              @db.Decimal(7, 3)
  // null only for source=PRIOR: a declared starting baseline has no graded
  // quality, recitation mode, or gap classification
  quality         RecitationQuality?
  mode            RecitationMode?
  situation       RecitationSituation?
  reason          String?
  notes           String?
  occurredAt      DateTime             @default(now())

  mistakes RecitationMistake[]

  @@index([studentId, occurredAt])
}

// One word a teacher flagged as a mistake during a recitation session, for
// targeted review later. Word positions follow the bundled Tanzil text as
// split by src/lib/quran-data/words.ts (1-based, words only — pause marks and
// the basmala prefix aren't counted). The same word flagged in several
// sessions is several rows; the lists merge them per word
// (src/lib/students/mistakes.ts). Resolving never deletes: it stamps
// resolvedAt/resolvedById so the row drops off the active list but keeps its
// history.
model RecitationMistake {
  id           String            @id @default(cuid())
  // denormalized from the session, for the per-student active lists
  studentId    String
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId    String
  session      RecitationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  surahNumber  Int
  ayah         Int
  wordPosition Int
  // the word as shown when it was flagged
  wordText     String
  type         MistakeType
  teacherId    String
  teacher      Teacher           @relation("MistakeFlaggedBy", fields: [teacherId], references: [id])
  // the session's date, so a backdated session dates its mistakes correctly
  flaggedAt    DateTime
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   Teacher?          @relation("MistakeResolvedBy", fields: [resolvedById], references: [id])
  createdAt    DateTime          @default(now())

  @@unique([sessionId, surahNumber, ayah, wordPosition])
  @@index([studentId, resolvedAt])
}

model PointsLog {
  id          String         @id @default(cuid())
  studentId   String
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // null = a bonus point ("+ نقاط إضافية"): no activity, value 1, and a
  // required note (enforced by a CHECK constraint in the migration). Several
  // bonus rows per student per day are fine: Postgres treats NULLs as
  // distinct in the unique index below. Restrict (not Prisma's SetNull
  // default for optional relations) keeps deleting an activity from turning
  // its past entries into bonus points.
  activityId  String?
  activity    PointsActivity? @relation(fields: [activityId], references: [id], onDelete: Restrict)
  note        String?
  teacherId   String
  teacher     Teacher        @relation(fields: [teacherId], references: [id])
  // snapshot of the activity's value/type at the moment it was logged, so
  // editing an activity later doesn't retroactively change past totals
  valueAtTime Int
  typeAtTime  PointType
  day         DateTime       @db.Date
  createdAt   DateTime       @default(now())

  @@unique([studentId, activityId, day])
  @@index([studentId, day])
}

// Append-only, one entry per student per day (mirrors PointsLog) — replaces
// what used to be a single mutable status/day pair on Student, which could
// only ever answer "what was she marked today," not "how many days was she
// present in this range." PENDING isn't stored: a day with no row is pending.
model AttendanceLog {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher          @relation(fields: [teacherId], references: [id])
  status    AttendanceStatus
  day       DateTime         @db.Date
  createdAt DateTime         @default(now())

  @@unique([studentId, day])
  @@index([studentId, day])
}

// ---------- Islamic calendar ----------

// A supervisor's moon-sighting correction for ONE occurrence of a core or
// optional occasion (e.g. Eid al-Fitr 1448 moved +1 day). Other years keep
// the plain Umm al-Qura date. offsetDays is limited to ±1/±2 by a CHECK
// constraint in the migration; resetting to 0 deletes the row.
model CalendarAdjustment {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  occasion   Occasion
  hijriYear  Int
  offsetDays Int
  createdAt  DateTime @default(now())

  @@unique([courseId, occasion, hijriYear])
}

// A course's own one-time event, past or future: upcoming plans as well as a
// record of what the course did (a khatm ceremony, a trip, ...).
model CalendarEvent {
  id                 String   @id @default(cuid())
  courseId           String
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  date               DateTime @db.Date
  // null = created by the supervisor. Deliberately not resolveTeacherId's
  // synthetic supervisor row: that row is looked up by name, so a teacher
  // who logged in under the same name would share it. A teacher may edit an
  // event only when this equals her own session teacherId, so a supervisor's
  // event is never editable by any teacher. Deleting a teacher keeps her
  // events and hands them to the supervisor (SetNull).
  createdByTeacherId String?
  createdByTeacher   Teacher? @relation(fields: [createdByTeacherId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([courseId, date])
}

// ---------- Resource bank (shared across ALL courses) ----------
//
// The only data in Namaa that isn't scoped to one course. Nothing here has a
// courseId: the course is reachable only through the creator, and bank
// queries never select the creator (src/lib/resources/data.ts) — only the
// site owner's moderation view does.

// Owner-extensible list of resource types (seeded with seven).
model ResourceType {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  resources Resource[]
}

model Resource {
  id          String       @id @default(cuid())
  // http(s) only, validated server-side (src/lib/resources/validate.ts)
  url         String
  title       String
  description String?
  ageFrom     Int
  ageTo       Int
  typeId      String
  type        ResourceType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  // normalized title + description for diacritic-insensitive search
  searchKey   String
  // exactly one creator while it has one; both null once the creator's
  // account is gone (then only the site owner can edit/delete it)
  createdByAdminId   String?
  createdByAdmin     Admin?   @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdByTeacherId String?
  createdByTeacher   Teacher? @relation(fields: [createdByTeacherId], references: [id], onDelete: SetNull)
  // set automatically at 3 open reports from different people, cleared when
  // the owner dismisses them; hidden resources show only to their creator
  hiddenAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tags    ResourceTag[]
  reports ResourceReport[]

  @@index([createdAt])
  @@index([typeId])
  @@index([createdByAdminId])
  @@index([createdByTeacherId])
}

model Tag {
  id        String   @id @default(cuid())
  // as first written; key is its normalized form (src/lib/resources/normalize.ts)
  name      String
  key       String   @unique
  createdAt DateTime @default(now())

  resources ResourceTag[]
}

model ResourceTag {
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
  @@index([tagId])
}

// One open report per person per resource (partial unique indexes in the
// migration). Resolved reports are kept with resolvedAt set.
model ResourceReport {
  id                String    @id @default(cuid())
  resourceId        String
  resource          Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  reason            String?
  reporterAdminId   String?
  reporterAdmin     Admin?    @relation(fields: [reporterAdminId], references: [id], onDelete: SetNull)
  reporterTeacherId String?
  reporterTeacher   Teacher?  @relation(fields: [reporterTeacherId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  @@index([resourceId, resolvedAt])
}

// ---------- Home memorization log («حفظي في البيت») ----------
//
// A SEPARATE record from official recitations: nothing that computes the
// student's position, gap warnings, the leaderboard, streaks or reports
// reads these tables. Only a teacher-recorded RecitationSession moves her.

// A portion the student is memorizing at home, within one surah. Its
// targets are copied in when it's created (later default changes don't
// rewrite it); staff may adjust them while it's active.
model HomeSegment {
  id           String          @id @default(cuid())
  studentId    String
  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  surahNumber  Int
  fromAyah     Int
  toAyah       Int
  targetListen Int
  targetRepeat Int
  targetRecite Int
  createdAt    DateTime        @default(now())
  // set when she marks it done, or when a teacher's official recitation
  // covers the whole segment (finishedBy says which)
  finishedAt   DateTime?
  finishedBy   HomeSegmentEnd?
  // set when a QURAN assignment created this segment (shown as «واجب»; not
  // counted toward the active-segment limit). Deleting the assignment
  // removes its untouched segments first; practised ones are kept as hers
  // and unlinked (SetNull).
  assignmentId String?
  assignment   Assignment?     @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  taps HomeTap[]

  @@unique([assignmentId, studentId])
  @@index([studentId, finishedAt])
}

// One "+" tap. Counts are always derived from taps, never stored. ayah null
// = a whole-segment counter (the ones with targets); otherwise a per-ayah
// counter. day = the student's local date, for daily activity (phase 3).
// A word a student marked herself while practising a home passage. A
// SEPARATE record from RecitationMistake: strictly private to her — no staff
// page, report, parent view, official mistakes list, points or position ever
// reads this table. At most one open mark per word (partial unique index in
// the migration): marking again changes its type; resolving stamps
// resolvedAt and keeps the row.
model HomeMistake {
  id           String      @id @default(cuid())
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  surahNumber  Int
  ayah         Int
  wordPosition Int
  // the word as shown when it was marked
  wordText     String
  type         MistakeType
  flaggedAt    DateTime    @default(now())
  resolvedAt   DateTime?

  @@index([studentId, resolvedAt])
}

model HomeTap {
  id        String      @id @default(cuid())
  segmentId String
  segment   HomeSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  studentId String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ayah      Int?
  kind      HomeTapKind
  day       DateTime    @db.Date
  createdAt DateTime    @default(now())

  @@index([segmentId, kind, ayah])
  @@index([studentId, day])
  @@index([studentId, createdAt])
}

// ---------- Assignments («الواجبات») ----------
//
// No points are given automatically; teachers award points in class with
// the existing PointsLog system.

// Targets either a whole group (targetGroupId set: includes students added
// later, archived students drop out) or specific students (targetGroupId
// null, one AssignmentStudent row each). surahNumber/fromAyah/toAyah are
// set only for QURAN. Ownership like CalendarEvent: createdByTeacherId null
// = the supervisor; a teacher edits/deletes only her own.
model Assignment {
  id                 String         @id @default(cuid())
  courseId           String
  course             Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  type               AssignmentType
  dueDate            DateTime?      @db.Date
  surahNumber        Int?
  fromAyah           Int?
  toAyah             Int?
  targetGroupId      String?
  targetGroup        Group?         @relation(fields: [targetGroupId], references: [id], onDelete: Cascade)
  createdByTeacherId String?
  createdByTeacher   Teacher?       @relation(fields: [createdByTeacherId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  students     AssignmentStudent[]
  completions  AssignmentCompletion[]
  homeSegments HomeSegment[]

  @@index([courseId, createdAt])
  @@index([targetGroupId])
}

model AssignmentStudent {
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([assignmentId, studentId])
  @@index([studentId])
}

// She ticked it done (unticking deletes the row). answer is unused for now:
// room for written answers later.
model AssignmentCompletion {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answer       String?
  doneAt       DateTime   @default(now())

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

// ---------- Daily tracker («جدول المتابعة») ----------
//
// Scores are always calculated from TrackerCheck rows, never stored
// (src/lib/tracker/data.ts).

// A daily item. Targets a whole group (targetGroupId) or specific students
// (TrackerItemStudent rows). Created by staff (createdByTeacherId; both
// creator fields null = the supervisor) or by a student for herself
// (createdByStudentId, always PENDING until staff approve and set value).
// days is a weekday bitmask, bit 0 = Sunday … bit 6 = Saturday (127 =
// every day). Archived instead of deleted: it stops counting from the day
// it was archived; earlier days keep it.
model TrackerItem {
  id                 String            @id @default(cuid())
  courseId           String
  course             Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title              String
  // 1–10; null only while a student's own item awaits approval
  value              Int?
  days               Int               @default(127)
  targetGroupId      String?
  targetGroup        Group?            @relation(fields: [targetGroupId], references: [id], onDelete: Cascade)
  status             TrackerItemStatus @default(APPROVED)
  createdByTeacherId String?
  createdByTeacher   Teacher?          @relation(fields: [createdByTeacherId], references: [id], onDelete: SetNull)
  createdByStudentId String?
  createdByStudent   Student?          @relation("TrackerItemByStudent", fields: [createdByStudentId], references: [id], onDelete: Cascade)
  // when staff approved or rejected it (a rejection shows for a week)
  reviewedAt         DateTime?
  archivedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  students TrackerItemStudent[]
  checks   TrackerCheck[]

  @@index([courseId, status])
  @@index([targetGroupId])
  @@index([createdByStudentId])
}

model TrackerItemStudent {
  itemId    String
  item      TrackerItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  studentId String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([itemId, studentId])
  @@index([studentId])
}

// One tick: item × student × her local day. Only today and yesterday can be
// ticked or unticked.
model TrackerCheck {
  id        String      @id @default(cuid())
  itemId    String
  item      TrackerItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  studentId String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  day       DateTime    @db.Date
  createdAt DateTime    @default(now())

  @@unique([itemId, studentId, day])
  @@index([studentId, day])
}

// ---------- «رفيق الحفظ» (independent learners, src/lib/rafiq) ----------
//
// Completely separate from courses: no Rafiq table references a course,
// student, teacher or admin, and no course code reads these tables. Every
// Rafiq query is scoped by the signed-in user's id (src/lib/rafiq/session.ts).

model RafiqUser {
  id                    String    @id @default(cuid())
  // trimmed + lowercased; independent of Admin.email (the same address may
  // hold both kinds of account)
  email                 String    @unique
  passwordHash          String
  // optional; only used to greet her
  name                  String?
  // for gender-aware wording; asked once at sign-up, editable in settings
  gender                Gender
  // every session token carries this; bumping it (password change or reset,
  // «تسجيل الخروج من جميع الأجهزة») ends every open session
  sessionVersion        Int       @default(0)
  // bcrypt hash of her recovery رمز (src/lib/rafiq/recovery.ts), shown once
  // at sign-up and on each regeneration; used to set a new password
  recoveryCodeHash      String
  recoveryCodeCreatedAt DateTime
  createdAt             DateTime  @default(now())
  lastLoginAt           DateTime?

  // her memorization plan (src/lib/rafiq/memorization.ts). null template =
  // she hasn't set up a plan yet. Unlike a course, she may change it any
  // time; planChangedAt then marks when, so gap approvals recorded before
  // the latest change stop counting (memorized ayat always count).
  planTemplate          PlanTemplate?
  planChangedAt         DateTime?
  // days a completed surah may go without review before it's flagged;
  // null = review reminders off (the default)
  reviewReminderDays    Int?
  // her own targets for the home memorization counters («حفظي في البيت»);
  // changing them also updates her active passages
  homeTargetListen      Int       @default(5)
  homeTargetRepeat      Int       @default(10)
  homeTargetRecite      Int       @default(3)
  // when her default note tags («متشابهات / تدبّر / تفسير») were created —
  // once, the first time she opens notes, so deleted defaults never return
  noteTagsSeededAt      DateTime?

  planItems     RafiqPlanItem[]
  sessions      RafiqSession[]
  mistakes      RafiqMistake[]
  homeSegments  RafiqHomeSegment[]
  homeTaps      RafiqHomeTap[]
  homeMistakes  RafiqHomeMistake[]
  notes         RafiqNote[]
  noteTags      RafiqNoteTag[]
  commitDays    RafiqCommitDays[]
  trackerItems  RafiqTrackerItem[]
  trackerChecks RafiqTrackerCheck[]
  calendarDays  RafiqCalendarDay[]
  calendarAdjustments RafiqCalendarAdjustment[]
  templates       TrackerTemplate[]
  templateReports TrackerTemplateReport[]

  // her calendar: the optional occasions she turned on (the core ones are
  // always shown), as Course.enabledOccasions
  enabledOccasions Occasion[] @default([])
}

// A personal day she added to her calendar (same meaning as CalendarEvent).
model RafiqCalendarDay {
  id          String    @id @default(cuid())
  userId      String
  user        RafiqUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  date        DateTime  @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, date])
}

// Her own moon-sighting correction for one occurrence of an occasion (same
// meaning as CalendarAdjustment); resetting to 0 deletes the row.
model RafiqCalendarAdjustment {
  id         String    @id @default(cuid())
  userId     String
  user       RafiqUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  occasion   Occasion
  hijriYear  Int
  offsetDays Int
  createdAt  DateTime  @default(now())

  @@unique([userId, occasion, hijriYear])
}

// The weekdays she intends to commit to, from a given day of hers onward
// (src/lib/rafiq/streak.ts). A change adds a row from that day, so past
// days keep the schedule they had. No row = every day.
model RafiqCommitDays {
  id            String    @id @default(cuid())
  userId        String
  user          RafiqUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  // weekday bitmask, bit 0 = Sunday … bit 6 = Saturday (as TrackerItem.days)
  days          Int
  effectiveFrom DateTime  @db.Date
  createdAt     DateTime  @default(now())

  @@unique([userId, effectiveFrom])
}

// One item of her own follow-up tracker («جدول المتابعة»), with its mark
// (1–10) and weekdays; same meaning as TrackerItem, without approval.
// Archived instead of deleted: it stops counting from that day on.
model RafiqTrackerItem {
  id         String    @id @default(cuid())
  userId     String
  user       RafiqUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  value      Int
  days       Int       @default(127)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  checks RafiqTrackerCheck[]

  @@index([userId, archivedAt])
}

// One tick: item × her local day (today or yesterday only).
model RafiqTrackerCheck {
  id        String           @id @default(cuid())
  itemId    String
  item      RafiqTrackerItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      RafiqUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       DateTime         @db.Date
  createdAt DateTime         @default(now())

  @@unique([itemId, day])
  @@index([userId, day])
}

// A passage she is memorizing, within one surah (same meaning as
// HomeSegment). Counts are always derived from taps. Nothing here moves her
// position; only a recorded NEW session does.
model RafiqHomeSegment {
  id                String    @id @default(cuid())
  userId            String
  user              RafiqUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  surahNumber       Int
  fromAyah          Int
  toAyah            Int
  targetListen      Int
  targetRepeat      Int
  targetRecite      Int
  createdAt         DateTime  @default(now())
  // set when she marks it done, or when a NEW session of hers covers the
  // whole passage (finishedBySession)
  finishedAt        DateTime?
  finishedBySession Boolean   @default(false)

  taps RafiqHomeTap[]

  @@index([userId, finishedAt])
}

// A word she marked while practising a home passage (same meaning as
// HomeMistake). Shown in her one mistakes list next to her session mistakes,
// labelled by source.
model RafiqHomeMistake {
  id           String      @id @default(cuid())
  userId       String
  user         RafiqUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  surahNumber  Int
  ayah         Int
  wordPosition Int
  wordText     String
  type         MistakeType
  flaggedAt    DateTime    @default(now())
  resolvedAt   DateTime?

  @@index([userId, resolvedAt])
}

// Her own note on one verse (src/lib/rafiq/notes.ts). Many per verse.
model RafiqNote {
  id          String    @id @default(cuid())
  userId      String
  user        RafiqUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  surahNumber Int
  ayah        Int
  text        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tags RafiqNoteTagLink[]

  @@index([userId, surahNumber, ayah])
  @@index([userId, createdAt])
}

// Her note tags. color is a key of the fixed palette (NOTE_COLORS in
// src/lib/rafiq/notes-rules.ts), never a raw colour value.
model RafiqNoteTag {
  id        String    @id @default(cuid())
  userId    String
  user      RafiqUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  notes RafiqNoteTagLink[]

  @@unique([userId, name])
}

model RafiqNoteTagLink {
  noteId String
  note   RafiqNote    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId  String
  tag    RafiqNoteTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
}

// One "+" tap (same meaning as HomeTap): ayah null = a whole-passage counter.
model RafiqHomeTap {
  id        String           @id @default(cuid())
  segmentId String
  segment   RafiqHomeSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  userId    String
  user      RafiqUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ayah      Int?
  kind      HomeTapKind
  // her local day
  day       DateTime         @db.Date
  createdAt DateTime         @default(now())

  @@index([segmentId, kind, ayah])
  @@index([userId, createdAt])
}

model RafiqPlanItem {
  id          String    @id @default(cuid())
  userId      String
  user        RafiqUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  surahNumber Int
  position    Int

  @@unique([userId, position])
  @@unique([userId, surahNumber])
}

// A session she logged herself; the same meaning as RecitationSession
// (NEW moves her position, REVIEW/LINK never do; PRIOR = memorization from
// before). Position, coverage and pages are always derived from these rows.
model RafiqSession {
  id              String               @id @default(cuid())
  userId          String
  user            RafiqUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  source          RecitationSource     @default(LOGGED)
  type            SessionType          @default(NEW)
  surahNumber     Int
  fromAyah        Int
  toAyah          Int
  pagesCalculated Decimal              @db.Decimal(7, 3)
  // her own optional assessment; null for PRIOR or when she skipped it
  quality         RecitationQuality?
  situation       RecitationSituation?
  reason          String?
  notes           String?
  // her local calendar date (today or up to 2 days back), for streaks
  day             DateTime             @db.Date
  // ordering within a day and for review reminders
  occurredAt      DateTime             @default(now())
  createdAt       DateTime             @default(now())

  mistakes RafiqMistake[]

  @@index([userId, occurredAt])
  @@index([userId, day])
}

// A word she flagged in one of her sessions (same meaning as
// RecitationMistake). Resolving stamps resolvedAt; the row stays.
model RafiqMistake {
  id           String       @id @default(cuid())
  userId       String
  user         RafiqUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId    String
  session      RafiqSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  surahNumber  Int
  ayah         Int
  wordPosition Int
  wordText     String
  type         MistakeType
  flaggedAt    DateTime
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@unique([sessionId, surahNumber, ayah, wordPosition])
  @@index([userId, resolvedAt])
}

// ---------- Tracker template bank («بنك جداول المتابعة») ----------
//
// Shared between «رفيق الحفظ» users, separate from the resource bank. Same
// rules: the publisher is never shown (bank queries never select it), a
// report button, auto-hidden at 3 open reports from different people, and
// the site owner (SITE_OWNER_EMAILS) reviews reports and may delete any
// template. A template is a snapshot: using it copies its items into her
// own tracker, and later edits on either side don't affect the other.

model TrackerTemplate {
  id                String     @id @default(cuid())
  title             String
  description       String?
  // normalized title + description for diacritic-insensitive search
  searchKey         String
  // added by the site owner, shown with «مقترح»
  suggested         Boolean    @default(false)
  // the Rafiq user who published it; null for the owner's own templates, or
  // once the publisher's account is deleted (the template stays, anonymous)
  createdByRafiqId  String?
  createdByRafiq    RafiqUser? @relation(fields: [createdByRafiqId], references: [id], onDelete: SetNull)
  // set at 3 open reports, cleared when the owner dismisses them; a hidden
  // template shows only to its publisher (and the owner)
  hiddenAt          DateTime?
  useCount          Int        @default(0)
  createdAt         DateTime   @default(now())

  items   TrackerTemplateItem[]
  reports TrackerTemplateReport[]

  @@index([createdAt])
  @@index([createdByRafiqId])
}

model TrackerTemplateItem {
  id         String          @id @default(cuid())
  templateId String
  template   TrackerTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title      String
  value      Int
  days       Int
  sortOrder  Int             @default(0)

  @@index([templateId])
}

// One open report per person per template (partial unique index in the
// migration). Resolved reports are kept with resolvedAt set.
model TrackerTemplateReport {
  id              String          @id @default(cuid())
  templateId      String
  template        TrackerTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  reason          String?
  reporterRafiqId String?
  reporterRafiq   RafiqUser?      @relation(fields: [reporterRafiqId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  resolvedAt      DateTime?

  @@index([templateId, resolvedAt])
  @@index([reporterRafiqId, createdAt])
}

// One row per failed login (parent, public board, student or supervisor), keyed by a
// salted hash of the client IP (never the raw IP). Used only for the
// brute-force lockout (src/lib/auth/login-lockout.ts), counted per scope;
// rows older than a day are pruned opportunistically.
model LoginAttempt {
  id        String     @id @default(cuid())
  scope     LoginScope
  ipHash    String
  createdAt DateTime   @default(now())

  @@index([scope, ipHash, createdAt])
}

// ---------- Enums ----------

// Labels live in src/lib/students/extra-info.ts. Values are never renamed:
// StudentInfoField rows store them.
enum StudentInfoBuiltin {
  MOTHER_NAME
  MOTHER_PHONE
  MOTHER_JOB
  FATHER_NAME
  FATHER_PHONE
  FATHER_JOB
  STUDENT_PHONE
  // مكان الدراسة أو العمل — separate from Student.grade
  STUDY_OR_WORK
}

// who last saved a StudentInfoValue
enum InfoEditor {
  ADMIN
  TEACHER
  PARENT
}

enum CalendarEditPermission {
  ADMIN_ONLY
  ALL_TEACHERS
}

// Recurring Hijri occasions. Names, Hijri month/day and core-vs-optional live
// in src/lib/calendar/occasions.ts. Values are never renamed: adjustments and
// Course.enabledOccasions store them.
enum Occasion {
  // core: always shown while the calendar is enabled
  RAMADAN_START
  EID_FITR
  ARAFAH
  EID_ADHA
  // optional presets, off until the course enables them
  HIJRI_NEW_YEAR
  ASHURA
  ISRA_MIRAJ
  MID_SHABAN
}

enum StreakMode {
  // present (IN) at least once that week
  ATTENDANCE
  // at least one logged NEW/REVIEW/LINK session that week (PRIOR baselines don't count)
  RECITATION
}

enum HomeTapKind {
  // سماع
  LISTEN
  // تكرار
  REPEAT
  // تسميع لأحد
  RECITE
}

enum HomeSegmentEnd {
  // she marked it «أتممتُ هذا المقطع»
  STUDENT
  // a teacher's official recitation covered the whole segment
  TEACHER_RECITED
}

enum AssignmentType {
  // حفظ/مراجعة من القرآن: creates a «واجب» segment in the home log
  QURAN
  // سؤال
  QUESTION
  // بحث
  RESEARCH
  // أخرى
  OTHER
}

enum TrackerItemStatus {
  APPROVED
  // a student's own item awaiting staff approval (can be ticked, doesn't count)
  PENDING
  // shown as «لم يُعتمد» for a week after reviewedAt, then hidden
  REJECTED
}

enum LoginScope {
  PARENT
  BOARD
  STUDENT
  // supervisor email + password login
  ADMIN
  // «رفيق الحفظ» (src/lib/rafiq/limits.ts). RAFIQ_ACCOUNT rows hold a salted
  // hash of the account's email in ipHash instead of the IP's, so guesses
  // spread across many addresses still lock that one account.
  RAFIQ_LOGIN
  RAFIQ_ACCOUNT
  RAFIQ_SIGNUP
  RAFIQ_RECOVER
}

enum AddStudentsPermission {
  ADMIN_ONLY
  ALL_TEACHERS
}

enum GroupGender {
  GIRLS
  BOYS
  MIXED
}

enum Gender {
  MALE
  FEMALE
}

enum VisibilityMode {
  ALL_TEACHERS
  ASSIGNED
}

enum PlanTemplate {
  MUSHAF_ORDER
  MUSHAF_REVERSE
  JUZ_AMMA_REVERSE
  CUSTOM
}

enum AttendanceStatus {
  IN
  OUT
  PENDING
}

enum PointType {
  ADD
  SUBTRACT
}

enum RecitationQuality {
  EXCELLENT
  GOOD
  NEEDS_REPEAT
}

enum RecitationMode {
  IN_PERSON
  ONLINE
}

// mirrors the 5 states from spec §5 gap-detection logic
enum RecitationSituation {
  CONTINUE
  NEXT
  SURAH_GAP
  AYAH_GAP
  EDIT
}

enum SessionType {
  // حفظ جديد — new memorization
  NEW
  // مراجعة — review of already-memorized material
  REVIEW
  // ربط — linking recently memorized portions together
  LINK
}

// Labels live in src/lib/students/mistake-types.ts (gendered by group).
// Values are never renamed: stored rows keep the type they were saved with.
enum MistakeType {
  // خطأ تشكيل
  PRONUNCIATION
  // خطأ تجويد
  TAJWEED
  // تم ردّها — forgot the word, the teacher prompted it
  FORGOT_PROMPTED
  // تعثّرت وصححت بنفسها — hesitated, then self-corrected
  HESITATED_SELF_CORRECTED
}

enum RecitationSource {
  // a real recitation session logged with a teacher
  LOGGED
  // a declared starting baseline entered when the student was added,
  // covering memorization from before she joined — included in her current
  // position / cumulative pages / gap-detection baseline, excluded from the
  // leaderboard's achievement view
  PRIOR
}
