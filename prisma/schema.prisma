// نماء (Namaa) — Prisma schema
// Design note: a student's "current position" (surah/ayah), cumulative pages,
// online-recitation count, and cumulative points are NOT stored as mutable
// counters. They are always derived from RecitationSession / PointsLog rows
// (latest session = current position, SUM(pagesCalculated) = cumulative pages,
// etc). This avoids an entire class of sync/drift bugs from incrementing
// counters across concurrent teachers, and makes the session log the single
// source of truth — matching how the log screen already works in the
// prototype. See src/lib/recitation/derive.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Accounts ----------

model Admin {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  // supervisor's own gender, used to conjugate UI text addressed to/about them
  // (e.g. مشرف/مشرفة). Optional and asked only once — see genderPrompted.
  gender         Gender?
  genderPrompted Boolean  @default(false)
  createdAt      DateTime @default(now())

  course Course?
}

// A course (دورة) is the multi-tenant boundary. Every other model hangs off
// courseId (directly or via a parent that has courseId), and every query in
// the app must be scoped by the current session's courseId.
model Course {
  id                      String                @id @default(cuid())
  name                    String
  code                    String                @unique
  adminId                 String                @unique
  admin                   Admin                 @relation(fields: [adminId], references: [id], onDelete: Cascade)
  addStudentsPermission   AddStudentsPermission @default(ADMIN_ONLY)
  visibilityMode          VisibilityMode        @default(ALL_TEACHERS)
  onlineRecitationEnabled Boolean               @default(true)
  // optional progress bars on the student detail screen, each toggled
  // course-wide by the supervisor. Off by default.
  showSurahProgress       Boolean               @default(false)
  showJuzProgress         Boolean               @default(false)
  showQuranProgress       Boolean               @default(false)
  showPlanProgress        Boolean               @default(false)
  // Public read-only leaderboard access (see src/lib/auth/board-session.ts),
  // independent of the teacher course code above. null = no public board.
  // Regenerating/revoking bumps boardCodeVersion, which every board session
  // is checked against, so old sessions die immediately.
  boardCode               String?               @unique
  boardCodeVersion        Int                   @default(0)
  boardCodeCreatedAt      DateTime?
  // Days a completed surah may go without a REVIEW/LINK session before the
  // student is flagged (src/lib/students/review.ts). null = reminders off.
  reviewReminderDays      Int?
  // What makes a week count toward a student's streak (see
  // src/lib/students/streak.ts). null = streaks off (the default).
  streakMode              StreakMode?
  // Islamic calendar (/calendar), staff-only. Off by default; the banner is
  // only shown while the calendar itself is enabled. The core occasions
  // (Ramadan, both Eids, Arafah) are always on; enabledOccasions lists only
  // the optional presets the course turned on (src/lib/calendar/occasions.ts).
  calendarEnabled         Boolean                @default(false)
  calendarBannerEnabled   Boolean                @default(false)
  calendarEditPermission  CalendarEditPermission @default(ADMIN_ONLY)
  enabledOccasions        Occasion[]             @default([])
  createdAt               DateTime               @default(now())

  teachers            Teacher[]
  groups              Group[]
  students            Student[]
  pointsActivities    PointsActivity[]
  calendarAdjustments CalendarAdjustment[]
  calendarEvents      CalendarEvent[]
}

model Teacher {
  id             String   @id @default(cuid())
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name           String
  // normalized (trimmed + lowercased) name used for case-insensitive login matching
  nameKey        String
  // teacher's own gender, used to conjugate UI text addressed to them directly
  // (e.g. سجّلي/سجّل). Optional and asked only once — see genderPrompted.
  gender         Gender?
  genderPrompted Boolean  @default(false)
  createdAt      DateTime @default(now())

  groupAssignments TeacherGroupAssignment[]
  recitationLogs   RecitationSession[]
  pointsLogs       PointsLog[]
  attendanceLogs   AttendanceLog[]
  mistakesFlagged  RecitationMistake[]      @relation("MistakeFlaggedBy")
  mistakesResolved RecitationMistake[]      @relation("MistakeResolvedBy")
  calendarEvents   CalendarEvent[]

  @@unique([courseId, nameKey])
  @@index([courseId])
}

// ---------- Course structure ----------

model Group {
  id        String      @id @default(cuid())
  courseId  String
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name      String
  // drives Arabic grammatical gender (طالب/طالبة, حاضر/حاضرة, ...) for every
  // student in this group. Defaults to GIRLS so existing groups keep
  // rendering exactly as before this field existed.
  gender    GroupGender @default(GIRLS)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  students           Student[]
  teacherAssignments TeacherGroupAssignment[]

  @@unique([courseId, name])
  @@index([courseId])
}

model TeacherGroupAssignment {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([teacherId, groupId])
}

model PointsActivity {
  id        String    @id @default(cuid())
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name      String
  value     Int       @default(1)
  type      PointType @default(ADD)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  logs PointsLog[]

  @@index([courseId])
}

// ---------- Students ----------

model Student {
  id           String       @id @default(cuid())
  courseId     String
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupId      String
  group        Group        @relation(fields: [groupId], references: [id])
  name         String
  age          Int
  // school grade (الصف), free text as the supervisor writes it (e.g. الخامس).
  // Optional: students added before this field existed have none.
  grade        String?
  planTemplate PlanTemplate @default(CUSTOM)
  createdAt    DateTime     @default(now())

  // Read-only parent access (see src/lib/auth/parent-session.ts). null =
  // no parent can log in. Regenerating/revoking bumps parentCodeVersion,
  // which every parent session is checked against, so old sessions die
  // immediately rather than at cookie expiry.
  parentCode          String?   @unique
  parentCodeVersion   Int       @default(0)
  parentCodeCreatedAt DateTime?

  planItems          PlanItem[]
  recitationSessions RecitationSession[]
  pointsLogs         PointsLog[]
  attendanceLogs     AttendanceLog[]
  mistakes           RecitationMistake[]

  @@index([courseId])
  @@index([groupId])
}

// A student's memorization plan: an ordered list of surahs, built from a
// template (reverse Mushaf order / Mushaf order / reverse Juz Amma / fully custom) and then freely
// reordered/edited. Gap detection walks this list by `position`, not by raw
// surah number — see spec adaptation note in the technical plan.
model PlanItem {
  id          String  @id @default(cuid())
  studentId   String
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  surahNumber Int
  position    Int

  @@unique([studentId, position])
  @@unique([studentId, surahNumber])
  @@index([studentId])
}

model RecitationSession {
  id              String               @id @default(cuid())
  studentId       String
  student         Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId       String
  teacher         Teacher              @relation(fields: [teacherId], references: [id])
  source          RecitationSource     @default(LOGGED)
  // Only NEW sessions (and PRIOR baselines, which are always NEW) advance
  // the student's position / coverage and go through gap detection.
  // REVIEW/LINK revisit covered material: logged and counted as practice
  // volume, but never move her forward. They feed the review reminders.
  type            SessionType          @default(NEW)
  surahNumber     Int
  fromAyah        Int
  toAyah          Int
  pagesCalculated Decimal              @db.Decimal(7, 3)
  // null only for source=PRIOR: a declared starting baseline has no graded
  // quality, recitation mode, or gap classification
  quality         RecitationQuality?
  mode            RecitationMode?
  situation       RecitationSituation?
  reason          String?
  notes           String?
  occurredAt      DateTime             @default(now())

  mistakes RecitationMistake[]

  @@index([studentId, occurredAt])
}

// One word a teacher flagged as a mistake during a recitation session, for
// targeted review later. Word positions follow the bundled Tanzil text as
// split by src/lib/quran-data/words.ts (1-based, words only — pause marks and
// the basmala prefix aren't counted). The same word flagged in several
// sessions is several rows; the lists merge them per word
// (src/lib/students/mistakes.ts). Resolving never deletes: it stamps
// resolvedAt/resolvedById so the row drops off the active list but keeps its
// history.
model RecitationMistake {
  id           String            @id @default(cuid())
  // denormalized from the session, for the per-student active lists
  studentId    String
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId    String
  session      RecitationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  surahNumber  Int
  ayah         Int
  wordPosition Int
  // the word as shown when it was flagged
  wordText     String
  type         MistakeType
  teacherId    String
  teacher      Teacher           @relation("MistakeFlaggedBy", fields: [teacherId], references: [id])
  // the session's date, so a backdated session dates its mistakes correctly
  flaggedAt    DateTime
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   Teacher?          @relation("MistakeResolvedBy", fields: [resolvedById], references: [id])
  createdAt    DateTime          @default(now())

  @@unique([sessionId, surahNumber, ayah, wordPosition])
  @@index([studentId, resolvedAt])
}

model PointsLog {
  id          String         @id @default(cuid())
  studentId   String
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // null = a bonus point ("+ نقاط إضافية"): no activity, value 1, and a
  // required note (enforced by a CHECK constraint in the migration). Several
  // bonus rows per student per day are fine: Postgres treats NULLs as
  // distinct in the unique index below. Restrict (not Prisma's SetNull
  // default for optional relations) keeps deleting an activity from turning
  // its past entries into bonus points.
  activityId  String?
  activity    PointsActivity? @relation(fields: [activityId], references: [id], onDelete: Restrict)
  note        String?
  teacherId   String
  teacher     Teacher        @relation(fields: [teacherId], references: [id])
  // snapshot of the activity's value/type at the moment it was logged, so
  // editing an activity later doesn't retroactively change past totals
  valueAtTime Int
  typeAtTime  PointType
  day         DateTime       @db.Date
  createdAt   DateTime       @default(now())

  @@unique([studentId, activityId, day])
  @@index([studentId, day])
}

// Append-only, one entry per student per day (mirrors PointsLog) — replaces
// what used to be a single mutable status/day pair on Student, which could
// only ever answer "what was she marked today," not "how many days was she
// present in this range." PENDING isn't stored: a day with no row is pending.
model AttendanceLog {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher          @relation(fields: [teacherId], references: [id])
  status    AttendanceStatus
  day       DateTime         @db.Date
  createdAt DateTime         @default(now())

  @@unique([studentId, day])
  @@index([studentId, day])
}

// ---------- Islamic calendar ----------

// A supervisor's moon-sighting correction for ONE occurrence of a core or
// optional occasion (e.g. Eid al-Fitr 1448 moved +1 day). Other years keep
// the plain Umm al-Qura date. offsetDays is limited to ±1/±2 by a CHECK
// constraint in the migration; resetting to 0 deletes the row.
model CalendarAdjustment {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  occasion   Occasion
  hijriYear  Int
  offsetDays Int
  createdAt  DateTime @default(now())

  @@unique([courseId, occasion, hijriYear])
}

// A course's own one-time event, past or future: upcoming plans as well as a
// record of what the course did (a khatm ceremony, a trip, ...).
model CalendarEvent {
  id                 String   @id @default(cuid())
  courseId           String
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  date               DateTime @db.Date
  // null = created by the supervisor. Deliberately not resolveTeacherId's
  // synthetic supervisor row: that row is looked up by name, so a teacher
  // who logged in under the same name would share it. A teacher may edit an
  // event only when this equals her own session teacherId, so a supervisor's
  // event is never editable by any teacher. Deleting a teacher keeps her
  // events and hands them to the supervisor (SetNull).
  createdByTeacherId String?
  createdByTeacher   Teacher? @relation(fields: [createdByTeacherId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([courseId, date])
}

// One row per failed code-only login (parent or public board), keyed by a
// salted hash of the client IP (never the raw IP). Used only for the
// brute-force lockout (src/lib/auth/login-lockout.ts), counted per scope;
// rows older than a day are pruned opportunistically.
model LoginAttempt {
  id        String     @id @default(cuid())
  scope     LoginScope
  ipHash    String
  createdAt DateTime   @default(now())

  @@index([scope, ipHash, createdAt])
}

// ---------- Enums ----------

enum CalendarEditPermission {
  ADMIN_ONLY
  ALL_TEACHERS
}

// Recurring Hijri occasions. Names, Hijri month/day and core-vs-optional live
// in src/lib/calendar/occasions.ts. Values are never renamed: adjustments and
// Course.enabledOccasions store them.
enum Occasion {
  // core: always shown while the calendar is enabled
  RAMADAN_START
  EID_FITR
  ARAFAH
  EID_ADHA
  // optional presets, off until the course enables them
  HIJRI_NEW_YEAR
  ASHURA
  ISRA_MIRAJ
  MID_SHABAN
}

enum StreakMode {
  // present (IN) at least once that week
  ATTENDANCE
  // at least one logged NEW/REVIEW/LINK session that week (PRIOR baselines don't count)
  RECITATION
}

enum LoginScope {
  PARENT
  BOARD
}

enum AddStudentsPermission {
  ADMIN_ONLY
  ALL_TEACHERS
}

enum GroupGender {
  GIRLS
  BOYS
  MIXED
}

enum Gender {
  MALE
  FEMALE
}

enum VisibilityMode {
  ALL_TEACHERS
  ASSIGNED
}

enum PlanTemplate {
  MUSHAF_ORDER
  MUSHAF_REVERSE
  JUZ_AMMA_REVERSE
  CUSTOM
}

enum AttendanceStatus {
  IN
  OUT
  PENDING
}

enum PointType {
  ADD
  SUBTRACT
}

enum RecitationQuality {
  EXCELLENT
  GOOD
  NEEDS_REPEAT
}

enum RecitationMode {
  IN_PERSON
  ONLINE
}

// mirrors the 5 states from spec §5 gap-detection logic
enum RecitationSituation {
  CONTINUE
  NEXT
  SURAH_GAP
  AYAH_GAP
  EDIT
}

enum SessionType {
  // حفظ جديد — new memorization
  NEW
  // مراجعة — review of already-memorized material
  REVIEW
  // ربط — linking recently memorized portions together
  LINK
}

// Labels live in src/lib/students/mistake-types.ts (gendered by group).
// Values are never renamed: stored rows keep the type they were saved with.
enum MistakeType {
  // خطأ تشكيل
  PRONUNCIATION
  // خطأ تجويد
  TAJWEED
  // تم ردّها — forgot the word, the teacher prompted it
  FORGOT_PROMPTED
  // تعثّرت وصححت بنفسها — hesitated, then self-corrected
  HESITATED_SELF_CORRECTED
}

enum RecitationSource {
  // a real recitation session logged with a teacher
  LOGGED
  // a declared starting baseline entered when the student was added,
  // covering memorization from before she joined — included in her current
  // position / cumulative pages / gap-detection baseline, excluded from the
  // leaderboard's achievement view
  PRIOR
}
